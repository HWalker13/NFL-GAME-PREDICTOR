---
import { pct } from '../lib/format.ts';
import { RESULTS_URL } from '../lib/links.ts';
import type { Site } from '../lib/data.ts';

interface Props {
  week: number;
  record: Site['record'];
}
const { week, record } = Astro.props;
const { picks, valueCalls: vc } = record;
---
<header class="header">
  <div class="band">
    <p class="brand"><a href="/">NFL picks</a></p>
    <h1>Week {week} · 2026</h1>
  </div>

  <div class="tiles">
    <section class="tile" aria-labelledby="tile-picks">
      <h2 id="tile-picks">Picks</h2>
      <p class="big">{picks.w}–{picks.l}</p>
      <p class="rate">{pct(picks.accuracy)} accuracy</p>
      <p class="sub">Vegas favorite {pct(picks.vegasFavorite)}</p>
    </section>
    <section class="tile" aria-labelledby="tile-value">
      <h2 id="tile-value">Value calls</h2>
      <p class="big">{vc.w}–{vc.l}{vc.push > 0 && <span class="push">{vc.push} {vc.push === 1 ? 'push' : 'pushes'}</span>}</p>
      <p class="rate">{vc.hitRate === null ? 'None graded yet' : `${pct(vc.hitRate)} hit rate`}</p>
      {vc.vegasExpected !== null && <p class="sub">Vegas expected {pct(vc.vegasExpected)}</p>}
      <p class="caveat"><a href={RESULTS_URL}>Small sample — read this as a trend, not proof.</a></p>
    </section>
  </div>
</header>

<style>
  .header { padding-block: 16px 12px; }
  .band {
    padding: 14px 18px 16px;
    border-radius: 14px;
    background: var(--brand);
    color: var(--on-brand);
    border-bottom: 4px solid var(--red);
  }
  .brand { margin: 0; font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .brand a { color: var(--on-brand-muted); text-decoration: none; }
  .brand a:hover { text-decoration: underline; }
  h1 { margin: 2px 0 0; font-size: 1.875rem; font-weight: 850; line-height: 1.15; letter-spacing: -0.01em; }

  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .tile {
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
  }
  h2 {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .big { margin: 2px 0 0; font-size: 1.75rem; font-weight: 850; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .push { display: block; margin-top: -2px; font-size: 0.8125rem; font-weight: 600; line-height: 1.3; color: var(--muted); white-space: nowrap; }
  .rate { margin: 2px 0 0; font-weight: 600; font-size: 0.9375rem; }
  .sub { margin: 2px 0 0; color: var(--muted); font-size: 0.875rem; }
  .caveat { margin: 8px 0 0; font-size: 0.75rem; line-height: 1.35; }
  .caveat a { color: var(--muted); }

  @media (min-width: 768px) {
    .band { padding: 18px 24px 20px; }
    h1 { font-size: 2.25rem; }
    .tile { padding: 14px 18px; }
    .big { font-size: 2rem; }
  }
</style>
