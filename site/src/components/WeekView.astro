---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import WeekTabs from './WeekTabs.astro';
import GameCard from './GameCard.astro';
import Footer from './Footer.astro';
import { site } from '../lib/site.ts';

interface Props {
  week: number;
}
const { week } = Astro.props;
const page = site.pages.get(week);
if (!page) throw new Error(`no page data for week ${week}`);
---
<Base
  title={`NFL picks · Week ${week} · 2026`}
  description={`A machine-learning model's straight-up NFL picks for week ${week} of 2026, next to the Vegas odds.`}
>
  <div class="wrap">
    <Header week={week} record={site.record} />
    <WeekTabs weeks={site.weeks} viewed={week} current={site.current} />
    <main>
      {page.banner && <p class="banner">{page.banner}</p>}
      <ol class="games">
        {page.cards.map((card) => <li><GameCard card={card} /></li>)}
      </ol>
    </main>
    <Footer generatedAt={site.generatedAt} asOf={site.asOf} commit={site.commit} />
  </div>
</Base>

<style>
  .banner {
    margin: 8px 0 12px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--note);
    color: var(--text);
    font-size: 0.9375rem;
  }
  .games { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 10px; }
</style>
