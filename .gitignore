# Python virtual environment (SPEC Section 11 — not committed)
venv/

# Large / generated data and model artifacts — regenerated locally, never in git.
# Ignore the contents but keep the empty directory structure via .gitkeep.
data/raw/*
data/processed/*
models/*
!data/raw/.gitkeep
# Phase 9: schedule snapshots are irreplaceable (upstream overwrites lines in
# place) -- commit them. `data/raw/*` (not `data/raw/`) is what lets this
# re-include work. Publish-time temp files stay ignored.
!data/raw/snapshots/
data/raw/snapshots/.*.tmp
!data/raw/pull_metadata.json
!data/processed/.gitkeep
!models/.gitkeep
# Phase 10: the frozen 2026 live models are the pre-registered artifacts
# (sha256 in docs/PHASE10_PREREG.md) -- tracked so they cannot be lost.
!models/live_2026_champion.joblib
!models/live_2026_challenger_calibrated.joblib

# Python bytecode / caches
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Phase 9 data-layer spike: scratch pulls/rebuilds (never the canonical cache)
data/phase9_scratch/

# Phase 10: live-script scratch output (dry runs, tests). The official record
# is data/live/ (tracked) -- written only with --live, by the owner.
data/live_scratch/
